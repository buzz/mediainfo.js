{
  "name": "mediainfo.js",
  "version": "0.3.8",
  "description": "Emscripten port of MediaInfoLib displays information about video and audio files.",
  "author": "buzz",
  "repository": {
    "type": "git",
    "url": "https://github.com/buzz/mediainfo.js"
  },
  "bugs": "https://github.com/buzz/mediainfo.js/issues",
  "homepage": "https://mediainfo.js.org/",
  "license": "BSD-2-Clause",
  "sideEffects": false,
  "keywords": [
    "mediainfo",
    "emscripten",
    "video",
    "audio",
    "media"
  ],
  "files": [
    "LICENSE.txt",
    "README.md",
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "BABEL_ENV=GULP gulp",
    "clean": "rimraf dist build",
    "lint": "eslint .",
    "release": "commit-and-tag-version",
    "test": "cd tests && pnpm test",
    "typecheck": "tsc --project ."
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "mediainfo.js": "./dist/esm/cli.js"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "browser": "./dist/esm-bundle/index.min.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umd/index.min.js",
  "jsdelivr": "./dist/umd/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/esm-bundle/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./MediaInfoModule.wasm": "./dist/MediaInfoModule.wasm",
    "./package.json": "./package.json"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "commit-and-tag-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "build",
        "scope": "deps",
        "section": "Upgrades"
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "style",
        "hidden": true
      },
      {
        "type": "refactor",
        "hidden": true
      },
      {
        "type": "perf",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ]
  },
  "dependencies": {
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/register": "^8.0.6",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-virtual": "^3.0.2",
    "@types/decompress": "^4.2.7",
    "@types/emscripten": "^1.41.6",
    "@types/gulp": "^4.0.18",
    "@types/gulp-rename": "^2.0.7",
    "@types/gulp-sourcemaps": "^0.0.38",
    "@types/node": "^26.6.1",
    "@types/vinyl-buffer": "^1.0.3",
    "@types/vinyl-source-stream": "^0.0.34",
    "@types/yargs": "^17.0.35",
    "@vitest/eslint-plugin": "^1.6.27",
    "@xmldom/is-dom-node": "^1.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "commit-and-tag-version": "^13.2.1",
    "csv-parse": "^7.0.2",
    "decompress": "^4.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^75.0.0",
    "globals": "^17.12.0",
    "gulp": "^5.0.1",
    "gulp-babel": "^8.1.0",
    "gulp-cli": "^3.1.0",
    "gulp-rename": "^2.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "xpath": "^0.0.34"
  }
}
